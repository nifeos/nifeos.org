#!/bin/sh
#
# Build partsfoundry.org: fetch the design record at the commit basalt pins and each crate in
# crates.toml at its pinned commit, render them with Eleventy, index them with Pagefind, check every
# internal link, and report.
#
# The record lives in nifeos/record and is never copied into this repository. basalt's pins.toml,
# on basalt's main, names the record commit that goes with the current distribution in its
# `[record]` table, and this script builds that commit. `--record-commit` builds another commit
# (the record's main, say, to preview a change before basalt's pin follows it), and `--record`
# builds a local checkout of the record, at its HEAD.
#
# Each crate's page is its README.md, from the crate's own repository at the full commit crates.toml
# names for it (lib/crates.cjs reads the file and refuses a branch name or a short hash). It is
# rendered at /crates/<crate>/. A relative link in a README to a file of that repository goes to the
# file on GitHub at the pinned commit, and a relative link to no file fails the build, as in the
# record.
#
# The output is target/build/site/; the report is target/build/summary.md, and report.json beside
# it holds the same numbers and examples. The build fails when a link inside the site reaches no
# page or no heading, when a relative link in the record or a crate README names no file, when a
# citation names a record that does not exist, or when a numbered record or a listed crate has no
# page at its address. It deploys nothing.
#
#     script/site                              # the record at basalt's pin
#     script/site --record-commit main         # the record at another commit or branch
#     script/site --record ../record           # a local checkout of the record, at its HEAD
#     script/site --install                    # reinstall the packages with `npm ci` first
#
# Node is pinned in .node-version and the packages in package-lock.json at exact versions.
# Eleventy, Pagefind and markdown-it-anchor are CI-only dependencies (ruled 2026-11-04 UTC): the
# lockfile is committed, they install with `npm ci --ignore-scripts`, each version is at least two
# weeks old when pinned, and a bump is an ordinary pull request. Any Node on PATH runs it; a
# version other than the pin gets a warning, not a refusal.
#
# EXAMPLES
#
#     script/site && python3 -m http.server -d target/build/site
#
# then browse to http://localhost:8000/. Search needs the site served over HTTP, since Pagefind
# fetches its index.
#
# BUGS
#
# - Heading identifiers follow GitHub's rule for ASCII headings. A heading with other punctuation
#   may get a different identifier here than on GitHub, and the fragment check fails the build on
#   a link written against GitHub's.
# - Links to sites outside this one are not checked. A remote outage must not fail a build.

set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
organization="https://github.com/nifeos"
cache="$root/target/sources"

usage() {
    echo "usage: script/site [--install] [--record <dir> | --record-commit <commit or branch>]" >&2
    exit 2
}

install=0
record_dir=""
record_commit=""
while [ $# -gt 0 ]; do
    case "$1" in
        --install) install=1 ;;
        --record) [ $# -ge 2 ] || usage; record_dir="$2"; shift ;;
        --record-commit) [ $# -ge 2 ] || usage; record_commit="$2"; shift ;;
        *) usage ;;
    esac
    shift
done
[ -z "$record_dir" ] || [ -z "$record_commit" ] || usage

command -v node >/dev/null 2>&1 || { echo "script/site: node is not on PATH; install the version in .node-version" >&2; exit 1; }
want="$(cat "$root/.node-version")"
have="$(node --version | sed 's/^v//')"
[ "$have" = "$want" ] || echo "script/site: warning: node $have on PATH, .node-version pins $want" >&2

# One commit of one repository, given by its URL, fetched shallow into the cache once and reused
# after.
fetch_commit() {
    url="$1" commit="$2"
    tree="$cache/${url##*/}-$commit"
    if [ ! -f "$tree/.site-fetch-complete" ]; then
        rm -rf "$tree"
        git init -q "$tree"
        git -C "$tree" fetch -q --depth=1 "$url" "$commit"
        git -C "$tree" checkout -q --detach FETCH_HEAD
        touch "$tree/.site-fetch-complete"
    fi
    echo "$tree"
}

# basalt's main, read once: it pins the record commit this site builds by default, and the nife
# commit a `nifeos/nife:<path>` reference in the record means. Only pins.toml is fetched.
basalt_commit="$(git ls-remote "$organization/basalt" refs/heads/main | cut -f1)"
[ -n "$basalt_commit" ] || { echo "script/site: cannot read basalt's main" >&2; exit 1; }
pins="$cache/basalt-pins-$basalt_commit.toml"
if [ ! -s "$pins" ]; then
    mkdir -p "$cache"
    scratch="$cache/basalt-$$"
    git init -q --bare "$scratch"
    git -C "$scratch" fetch -q --depth=1 --filter=blob:none "$organization/basalt" "$basalt_commit"
    git -C "$scratch" show "$basalt_commit:pins.toml" > "$pins.partial"
    mv "$pins.partial" "$pins"
    rm -rf "$scratch"
fi
# The `commit` key of one table of pins.toml, and nothing from any other table.
pin() {
    awk -v want="[$1]" '
        /^\[/ { table = $0; next }
        table == want && $1 == "commit" { gsub(/"/, "", $3); print $3; exit }
    ' "$pins"
}
nife_commit="$(pin nife)"
echo "$nife_commit" | grep -Eq '^[0-9a-f]{40}$' ||
    { echo "script/site: basalt's pins.toml at $basalt_commit pins no nife commit" >&2; exit 1; }

record_source="pin"
if [ -n "$record_dir" ]; then
    record="$(cd "$record_dir" && pwd)"
    record_commit="$(git -C "$record" rev-parse HEAD)"
    record_source="local"
else
    if [ -z "$record_commit" ]; then
        record_commit="$(pin record)"
        echo "$record_commit" | grep -Eq '^[0-9a-f]{40}$' ||
            { echo "script/site: basalt's pins.toml at $basalt_commit pins no record commit" >&2; exit 1; }
    else
        record_source="override"
        # A full commit is used as given; a branch name is read from the record's remote.
        if ! echo "$record_commit" | grep -Eq '^[0-9a-f]{40}$'; then
            named="$record_commit"
            record_commit="$(git ls-remote "$organization/record" "refs/heads/$named" | cut -f1)"
            [ -n "$record_commit" ] ||
                { echo "script/site: nifeos/record has no branch $named; pass a full commit or a branch" >&2; exit 1; }
        fi
    fi
    record="$(fetch_commit "$organization/record" "$record_commit")"
fi

# Each crate in crates.toml, at its pinned commit. The list build.mjs reads holds one line per
# crate: its name, repository, commit and the fetched tree.
crates="$cache/crates.list"
crate_pins="$(node "$root/lib/crates.cjs" "$root/crates.toml")" || exit 1
: > "$crates.partial"
echo "$crate_pins" | while read -r name repository commit; do
    [ -n "$name" ] || continue
    tree="$(fetch_commit "https://github.com/$repository" "$commit")"
    [ -f "$tree/README.md" ] ||
        { echo "script/site: $repository at $commit has no README.md for crate $name" >&2; exit 1; }
    echo "$name $repository $commit $tree" >> "$crates.partial"
done
mv "$crates.partial" "$crates"

if [ "$install" -eq 1 ] || [ ! -d "$root/node_modules" ] ||
    ! cmp -s "$root/package-lock.json" "$root/node_modules/.package-lock.json.site"; then
    (cd "$root" && npm ci --ignore-scripts --no-audit --no-fund)
    cp "$root/package-lock.json" "$root/node_modules/.package-lock.json.site"
fi

SITE_RECORD="$record" SITE_RECORD_COMMIT="$record_commit" SITE_RECORD_SOURCE="$record_source" \
    SITE_BASALT_COMMIT="$basalt_commit" SITE_NIFE_COMMIT="$nife_commit" SITE_CRATES="$crates" \
    exec node "$root/build.mjs"
